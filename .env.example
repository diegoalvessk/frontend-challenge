# Ativa a API simulada (MSW + Socket.IO simulado). Padrão: true.
# Com "false", as chamadas vão para VITE_API_URL / VITE_SOCKET_URL reais.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST (Axios). Padrão: /api (interceptado pelo MSW).
VITE_API_URL=/api

# Endereço do servidor Socket.IO. Padrão: host fictício interceptado pelo MSW.
VITE_SOCKET_URL=wss://realtime.kurio.mock
